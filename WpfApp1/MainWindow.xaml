<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title= "CyberSecurity Assistant" Height="720" Width="1200"
        Background="Black">

    <Window.Resources>

        <!-- BUTTON STYLE -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#00FF99"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="45"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- SIDEBAR -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE -->
        <Border Grid.Column="0"
                Background="#111827">

            <StackPanel Margin="20">
                

                <!-- CYBER LOGO -->
                <Border Background="#0F172A"
        CornerRadius="15"
        Padding="15"
        Margin="0,10,0,20">

                    <StackPanel>

                        <TextBlock Text="CYBER"
                   Foreground="#00FF99"
                   FontSize="34"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

                        <TextBlock Text="SECURITY AI"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,0"/>

                        <TextBlock Text="Threat Detection • Safe Browsing • AI Protection"
                   Foreground="#94A3B8"
                   FontSize="11"
                   TextAlignment="Center"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- SYSTEM STATUS -->
                <Border Background="#111827"
        CornerRadius="12"
        Padding="10"
        Margin="0,10,0,20">

                    <StackPanel>

                        <TextBlock Text="SYSTEM STATUS"
                   Foreground="#00FF99"
                   FontWeight="Bold"/>

                        <TextBlock Text="● AI Core Online"
                   Foreground="Lime"
                   Margin="0,5,0,0"/>

                        <TextBlock Text="● Threat Scanner Active"
                   Foreground="Lime"
                   Margin="0,5,0,0"/>

                        <TextBlock Text="● Secure Connection Established"
                   Foreground="Lime"
                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>
                <!-- BUTTONS -->

                <Button x:Name="NewChatButton"
                    Content="＋ New Chat"
                    Style="{StaticResource CyberButton}"
                    Margin="0,10,0,10"
                    Click="NewChatButton_Click"/>

                <Button x:Name="ResetButton"
                    Content="🗑 Reset Chat"
                    Style="{StaticResource CyberButton}"
                    Background="#DC2626"
                    Foreground="White"
                    Margin="0,0,0,20"
                    Click="ResetButton_Click"/>


            </StackPanel>

        </Border>

        <!-- MAIN CHAT -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="90"/>
            </Grid.RowDefinitions>

            <!-- TOP -->
            <Border Grid.Row="0"
                    Background="#111827">

                <TextBlock Text="CyberSecurity Assistant"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>

            </Border>

            <!-- CHAT AREA -->
            <ScrollViewer x:Name="ChatScrollViewer"
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">

                <StackPanel x:Name="ChatPanel"
                            Margin="20"/>

            </ScrollViewer>

            <!-- INPUT -->
            <Grid Grid.Row="2"
                  Margin="15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <!-- INPUT BOX -->
                <Border Background="#1E293B"
                        CornerRadius="15"
                        Margin="0,0,10,0">

                    <TextBox x:Name="UserInput"
                    KeyDown="UserInput_KeyDown"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="White"
                    FontSize="16"
                    Padding="15"/>

                </Border>

                <!-- SEND -->
                <Button Grid.Column="1"
                        Content="SEND"
                        Style="{StaticResource CyberButton}"
                        Click="SendButton_Click"/>

            </Grid>

        </Grid>

    </Grid>


</Window>
